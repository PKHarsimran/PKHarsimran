# Shared frame and typography; the bundled font is installed by the workflow.
Set FontSize 25
Set FontFamily "ProfileMono"
Set Theme {"name":"Profile Studio","black":"#0d1117","red":"#ff7b92","green":"#43e6c5","yellow":"#f4d485","blue":"#7eb6ff","magenta":"#a995ff","cyan":"#43e6c5","white":"#e6edf3","brightBlack":"#93a4b8","brightRed":"#ff7b92","brightGreen":"#43e6c5","brightYellow":"#f4d485","brightBlue":"#7eb6ff","brightMagenta":"#a995ff","brightCyan":"#43e6c5","brightWhite":"#ffffff","background":"#101722","foreground":"#e6edf3","selection":"#29364b","cursor":"#43e6c5"}
Set Padding 24
Set Margin 12
Set MarginFill "#0d1117"
Set BorderRadius 14
Set LineHeight 1.0
Set Framerate 12
Set Shell bash
Set WindowBar Rings
Set CursorBlink false
